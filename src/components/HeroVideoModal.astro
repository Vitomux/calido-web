---
interface Props {
	clipPreview: string;
	videoPrincipal: string;
	slug: string;
}

const { clipPreview, videoPrincipal, slug } = Astro.props;
const vtName = `hero-media-${slug}`;
---

<div
	class="hero-video-modal relative h-screen w-full cursor-pointer"
	role="button"
	tabindex="0"
	aria-label="Reproducir video"
	data-slug={slug}
>
	<video
		src={clipPreview}
		autoplay
		muted
		loop
		playsinline
		class="pointer-events-none absolute inset-0 h-full w-full object-cover"
		data-vt-name={vtName}
		style={{ viewTransitionName: vtName, viewTransitionClass: "vt-morph" }}
	></video>

	<div class="pointer-events-none absolute inset-0 flex items-center justify-center text-cream" aria-hidden="true">
		<svg viewBox="0 0 194 186" fill="currentColor" class="h-32 w-28 rotate-90">
			<path
				d="M82.7468 8.54704C88.7458 -2.84902 105.064 -2.84901 111.063 8.54704L191.946 162.198C197.555 172.853 189.829 185.651 177.788 185.651H16.0218C3.98111 185.651 -3.74501 172.853 1.86365 162.198L82.7468 8.54704Z"
			></path>
		</svg>
	</div>
</div>

<div
	class="hero-video-modal-overlay fixed inset-0 z-50 hidden items-center justify-center bg-ink/80 p-11"
	data-open="false"
>
	<video
		class="hero-video-modal-video max-h-full max-w-full object-contain"
		src={videoPrincipal}
		controls
		style={{ viewTransitionName: "none", viewTransitionClass: "vt-morph" }}
	></video>

	<button
		type="button"
		class="hero-video-modal-rotate absolute top-4 right-4 z-20 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-cream/10 text-cream landscape:hidden md:hidden"
		aria-label="Ver en horizontal"
		aria-pressed="false"
	>
		<svg viewBox="0 0 24 24" fill="none" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg">
			<rect x="7" y="2" width="10" height="16" rx="1.5" stroke="currentColor" stroke-width="1.5"></rect>
			<path d="M19 11a7 7 0 1 1-2.5-5.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
			<path d="M19 5v4h-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
			></path>
		</svg>
	</button>
</div>

<script>
	import { gsap } from "gsap";

	// Reveals this page's real content once it's ready, by fading out and removing the
	// full-viewport clone that Layout.astro's blocking <head> script recreated before
	// first paint (see WorkListItem.astro for where the handoff originates). Same
	// "loading screen" pattern as the Drawer's preopen mechanism, just applied to a
	// dynamically-created clone instead of an always-present element.
	function revealHeroClone(hero: HTMLElement, previewVideo: HTMLVideoElement | null) {
		const clone = document.getElementById("hero-clone-loading") as HTMLVideoElement | null;
		if (!clone || clone.dataset.slug !== hero.dataset.slug) return;

		const reveal = () => {
			gsap.to(clone, {
				opacity: 0,
				duration: 0.175,
				ease: "power1.out",
				onComplete: () => clone.remove(),
			});
		};

		// DOM readiness (readyState/DOMContentLoaded) fires long before the real preview
		// <video> has actually decoded a frame — revealing on that signal dropped a black
		// flash between the clone fading out and the real video painting anything. Wait
		// for an actual decoded frame instead: HAVE_CURRENT_DATA (2) means readyState
		// already has one, otherwise wait for "loadeddata", the event that fires the
		// moment it gets one.
		if (previewVideo && previewVideo.readyState < 2) {
			previewVideo.addEventListener("loadeddata", reveal, { once: true });
		} else {
			reveal();
		}
	}

	function initHeroVideoModal() {
		document.querySelectorAll<HTMLElement>(".hero-video-modal").forEach((hero) => {
			const overlay = hero.nextElementSibling as HTMLElement | null;
			if (!overlay || !overlay.classList.contains("hero-video-modal-overlay")) return;
			const previewVideo = hero.querySelector<HTMLVideoElement>("video");
			const modalVideo = overlay.querySelector<HTMLVideoElement>(".hero-video-modal-video");
			const rotateBtn = overlay.querySelector<HTMLButtonElement>(".hero-video-modal-rotate");
			const vtName = previewVideo?.dataset.vtName;

			revealHeroClone(hero, previewVideo);

			rotateBtn?.addEventListener("click", () => {
				const rotated = overlay!.classList.toggle("force-landscape");
				rotateBtn.setAttribute("aria-pressed", String(rotated));
			});

			function withViewTransition(mutate: () => void) {
				if (typeof document.startViewTransition === "function") {
					document.startViewTransition(mutate);
				} else {
					mutate();
				}
			}

			function openModal() {
				withViewTransition(() => {
					if (vtName) {
						if (previewVideo) previewVideo.style.viewTransitionName = "none";
						if (modalVideo) modalVideo.style.viewTransitionName = vtName;
					}
					overlay!.setAttribute("data-open", "true");
					overlay!.classList.remove("hidden");
					overlay!.classList.add("flex");
					modalVideo?.play().catch(() => {});
				});
			}

			function closeModal() {
				// No view transition on the way out — straight back to the hero, no
				// morph animation. Only opening still animates.
				if (vtName) {
					if (modalVideo) modalVideo.style.viewTransitionName = "none";
					if (previewVideo) previewVideo.style.viewTransitionName = vtName;
				}
				overlay!.setAttribute("data-open", "false");
				overlay!.classList.add("hidden");
				overlay!.classList.remove("flex");
				overlay!.classList.remove("force-landscape");
				rotateBtn?.setAttribute("aria-pressed", "false");
				modalVideo?.pause();
			}

			hero.addEventListener("click", openModal);
			hero.addEventListener("keydown", (event) => {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					openModal();
				}
			});

			overlay.addEventListener("click", (event) => {
				if (event.target === overlay) closeModal();
			});
		});
	}

	initHeroVideoModal();
</script>
