---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import FullSizeVideo from "../components/FullSizeVideo.astro";
import { withBase } from "../lib/paths";

const ORDEN_HOME = [
	"super-chatarra",
	"alsina-carson-todo-me-extraña",
	"uber-drive",
	"por-los-colores",
	"cuanto-dolio",
];

const destacadosPorSlug = new Map(
	(await getCollection("trabajos", ({ data }) => data.destacado)).map((trabajo) => [
		trabajo.id,
		trabajo,
	])
);

const trabajosHome = ORDEN_HOME.map((slug) => destacadosPorSlug.get(slug)).filter(
	(trabajo): trabajo is CollectionEntry<"trabajos"> => Boolean(trabajo)
);

function getClipSrc(trabajo: CollectionEntry<"trabajos">) {
	const clip = trabajo.data.galeria.find((archivo) => /\.mp4$/i.test(archivo));
	return clip ? withBase(encodeURI(`/trabajos/${trabajo.id}/galeria/${clip}`)) : "";
}
---

<Layout>
	{
		trabajosHome.map((trabajo) => (
			<FullSizeVideo videoSrc={getClipSrc(trabajo)} titulo={trabajo.data.titulo} slug={trabajo.id} />
		))
	}
</Layout>
